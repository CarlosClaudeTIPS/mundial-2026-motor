# Sin estas variables la app funciona en MODO LOCAL (datos en el navegador).
# Con ellas, los datos se sincronizan con Supabase (ver supabase/schema.sql).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional, solo modo local (vistas previas/demos): entra automáticamente con ese usuario.
# VITE_AUTOLOGIN=admin:1234

# Solo para las funciones de servidor (api/*.js en Vercel). NUNCA con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
